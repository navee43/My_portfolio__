# Copy this file to .env.local for local development.
# None of these are required: the site builds and runs without any of them.

# The public address of the site. Used for share previews, the sitemap and
# canonical links. On Vercel this is filled in automatically if left empty.
# Example: https://naveenyadav.dev
NEXT_PUBLIC_SITE_URL=

# Optional. Only needed if the GitHub section hits GitHub's anonymous rate
# limit (60 requests an hour per server). A fine-grained token with
# "Public repositories (read-only)" access is enough. Never commit a real token.
GITHUB_TOKEN=
